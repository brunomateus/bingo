# Config do app web no Firebase Console > Configurações do projeto > Seus apps.
# Copie para .env.local (não versionado). Estes valores são públicos por design
# (vão no bundle) — o que protege os dados são as regras do Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Desenvolvimento local contra o Firebase Emulator Suite (npm run emulador).
# Com o emulador, os valores acima podem ser fictícios, desde que o
# VITE_FIREBASE_PROJECT_ID case com o projeto usado no emulador (demo-bingo).
VITE_FIREBASE_EMULADOR=false

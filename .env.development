# Perfil de desenvolvimento (`npm run dev`): aponta para o emulador. Projeto
# "demo-*" roda 100% offline, sem credencial real — por isso este arquivo é
# versionado. Para falar com o projeto de verdade, crie um .env.local (ignorado
# pelo git) com os valores do .env.example; ele tem precedência sobre este.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bingo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-bingo
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_EMULADOR=true

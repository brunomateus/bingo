{
  "name": "bingo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integracao",
    "test:watch": "vitest",
    "estilos:build": "node scripts/build-bjcp-styles.mjs",
    "emulador": "firebase emulators:start --project demo-bingo",
    "test:unit": "vitest run",
    "criar-organizador": "node scripts/criar-organizador.mjs",
    "test:integracao": "firebase emulators:exec --only firestore --project demo-bingo-testes \"vitest run --config vitest.integracao.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "firebase-tools": "^14.27.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.2.8"
  }
}
